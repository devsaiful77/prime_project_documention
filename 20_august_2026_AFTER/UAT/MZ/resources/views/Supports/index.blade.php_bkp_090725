            function handleAccountTypeChange(account_type) {
                $(".oldButton, .newButton, .acc_number, .account_number, .customer_id, .mobile, .date, .dropMobile, .cif_mobile, .dropMobileWrap").hide();

                $('input[name="account_number"]').val('');
                $('input[name="cif_mobile"]').val('');

                if (account_type == "1" || account_type == "3") {
                    $(".dropMobile, .cif_mobile, .dropMobileWrap").show();
                } else {
                    $(".oldButton, .account_number").show();
                }
            }

            $(document).on('ifChecked', '.account-type', function () {
                let selectedType = $(this).val();
                handleAccountTypeChange(selectedType);
            });

            let preSelected = $('input[name="account_type"]:checked').val();
            if (preSelected) {
                handleAccountTypeChange(preSelected);
            }
        });

