<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Redirect;
use Illuminate\Contracts\Encryption\DecryptException;

use App\Http\Requests;
use App\Http\Requests\UnitRequest;
use App\SMSEmail;
use App\SMSEmailTmp;

class SMSEmailsController extends Controller
{
    public $checker = false;
    public function __construct()
    {
       // $this->middleware('ability:superadmin|admin,adminActivity|accessSMSEmail');
        $this->middleware(['role_or_permission:superadmin|admin|accessSMSEmail|accessSMSEmailChecker']);
        parent::__construct();
    }

    public function accessSMSEmailChecker(){
        if (Auth::check() && Auth::user()->hasPermissionTo('accessSMSEmailChecker')) {
            return $this->checker = true;
        }else{
            return $this->checker;
        }
    }

    public function index(Request $request)
    {
        $sMSEmailModelName = new SMSEmail;
        $title = " Edit Product Type";
        $title_for_layout = "Edit Product Type";
        $checker = $this->accessSMSEmailChecker();

        $dataForView = $sMSEmailModelName->first();

        $id = (!empty($dataForView['id'])) ? $dataForView['id'] : 0;


        $title = "SMS and Email Template";
        $title_for_layout = "SMS and Email Template";
        return view('SMSEmails.index',compact('title','title_for_layout','dataForView','id', 'checker'));
    }

    public function smsEmailQueueList(){
        $title = "SMS and Email Template";
        $title_for_layout = "SMS and Email Template Queue";
        $checker = $this->accessSMSEmailChecker();
        if($checker){
            $isChecker = true;
            $dataForView = SMSEmailTmp::whereNotIn('form_status', [7, -1])->first();
        }else{
            $isChecker = false;
            $dataForView = SMSEmailTmp::whereIn('form_status', [7, -1])->orderBy('id', 'DESC')->first();
        }
        $oldDataForView = SMSEmail::first();
        $id = (!empty($dataForView['id'])) ? $dataForView['id'] : 0;

        return view('SMSEmails.index_tmp', compact('title','title_for_layout','dataForView','id', 'oldDataForView', 'isChecker'));
    }

    public function smsEmailAssign($id){
        $tmpData = SMSEmailTmp::findOrFail($id);

        $tmpData->form_status = 1;
        $tmpData->modified_by = Auth::user()->user_id;
        $tmpData->save();

        flash('Assigned Successfully from your End!', 'success');
        return redirect()->back();
    }

    public function smsEmailSendback(Request $request, $id){
        $checker = $this->accessSMSEmailChecker();
        if ($checker == false) {
            abort(403, 'You do not have permission to access this page.');
        }
        $request->validate([
            'comments' => 'required'
        ]);

        $tmpData = SMSEmailTmp::findOrFail($id);
        $tmpData->form_status = 7;
        $tmpData->modified_by = null;
        $tmpData->comments = $request->comments;
        $tmpData->save();

        flash('Send back Successfully!', 'success');    
        return redirect()->back();
    }

    public function smsEmailReject(Request $request, $id){
        $checker = $this->accessSMSEmailChecker();
        if ($checker == false) {
            abort(403, 'You do not have permission to access this page.');
        }

        $request->validate([
            'comments' => 'required'
        ]);

        $tmpData = SMSEmailTmp::findOrFail($id);
        $tmpData->form_status = -1;
        $tmpData->modified_by = Auth::user()->user_id;
        $tmpData->comments = $request->comments;
        $tmpData->save();

        flash('Request rejected!!', 'danger');
        return Redirect::back();
    }


    public function store($id = null, Request $request)
    {
        $checker = $this->accessSMSEmailChecker();
        if($checker){
            abort(403, 'You do not have permission to access this.');
        }
        try {
            $id = decrypt($id);
        } catch (DecryptException $e) {
            abort(403,'Something went wrong. Please contact with technical support');
        }

        if ($id == 0) {
            /* Save for the first time */
            $sMSEmail = new SMSEmailTmp();
            $sMSEmail->created_by = Auth::user()->id;
            $sMSEmail->updated_by = Auth::user()->id;
            $sMSEmail->action = "Add";
            
        } else {
            /* Update for next time */
            
            $existingTmpRecords = SMSEmailTmp::where('master_id', $id)->get();
        
            $hasInvalidRecord = $existingTmpRecords->contains(function ($record) {
                return $record->form_status != 7 && $record->form_status != -1;
            });

            if ($hasInvalidRecord) {
                flash('An entry already exists, please wait for Checker Approval', 'danger');
                return Redirect::back();
            }

            $sMSEmailModel = new SMSEmailTmp();
            $sMSEmail = $sMSEmailModel->where('id', $id)
                ->where('form_status','<>', 7)
                ->where('form_status', '<>', -1)
                ->first();
            
            if (empty($sMSEmail)) {
                $sMSEmail = new SMSEmailTmp();
                $sMSEmail->created_by = Auth::user()->id;
            }
            $sMSEmail->updated_by = Auth::user()->id;
            $sMSEmail->action = "Edit";
            $sMSEmail->master_id = $id;
        }
        $sMSEmail->status = 2;
        $sMSEmail->issue_opening_sms_wform = trim($request->issue_opening_sms_wform);
        $sMSEmail->issue_opening_sms_complaint = trim($request->issue_opening_sms_complaint);
        $sMSEmail->issue_opening_email_wform = trim($request->issue_opening_email_wform);
        $sMSEmail->issue_opening_email_complaint = trim($request->issue_opening_email_complaint);
        $sMSEmail->issue_closing_sms_wform = trim($request->issue_closing_sms_wform);
        $sMSEmail->issue_closing_sms_complaint = trim($request->issue_closing_sms_complaint);
        $sMSEmail->issue_closing_email_wform = trim($request->issue_closing_email_wform);
        $sMSEmail->issue_closing_email_complaint = trim($request->issue_closing_email_complaint);

        $sMSEmail->otp_sms = trim($request->otp_sms);
        $sMSEmail->otp_email = trim($request->otp_email);

        $sMSEmail->send_back_sms = trim($request->send_back_sms);
        $sMSEmail->send_back_email = trim($request->send_back_email);

        $sMSEmail->send_back_auto_sms = trim($request->send_back_auto_sms);
        $sMSEmail->send_back_auto_email = trim($request->send_back_auto_email);

        $sMSEmail->send_back_closed_sms = trim($request->send_back_closed_sms);
        $sMSEmail->send_back_closed_email = trim($request->send_back_closed_email);

	$sMSEmail->user_notify_sms  = trim($request->user_notify_sms);
	$sMSEmail->user_notify_email = trim($request->user_notify_email);

        $sMSEmail->unreachable_cust_sms = trim($request->unreachable_cust_sms);
        $sMSEmail->unreachable_cust_email = trim($request->unreachable_cust_email);
        $sMSEmail->non_cust_sms = trim($request->non_cust_sms);
        $sMSEmail->non_cust_email = trim($request->non_cust_email);
        $sMSEmail->escalation_email = trim($request->escalation_email);
        $sMSEmail->ip = $this->getClientIp();

        if ($sMSEmail->save()) {
            flash('SMS and Emails has been saved successfully to review for checker', 'success');
            return redirect('/SMS-Emails');
        } else {
            flash('Failed to save SMS and Emails, Please try again','danger');
        }
    }

    public function approveSMSMail($id){
        $checker = $this->accessSMSEmailChecker();
        if($checker == false){
            abort(403, 'You do not have permission to access this.');
        }
        DB::beginTransaction();
        
        try {
            // $sMSEmailTmp = DB::table('sms_email_template_tmps')->where('status', '!=', 3)->first();
            $sMSEmailTmp = SMSEmailTmp::findOrFail($id);
            // $sMSEmailTmp = DB::table('group_info_tmps')->where('id', $id)->where('status', 0)->first();
            
            if (!$sMSEmailTmp) {
                flash('SMS Email info not found or not approved yet.', 'danger');
                return redirect()->back();
            }

            $sMSEmailData = [
                'issue_opening_sms_wform'           => $sMSEmailTmp->issue_opening_sms_wform,
                'issue_opening_sms_complaint'       => $sMSEmailTmp->issue_opening_sms_complaint,
                'issue_opening_email_wform'         => $sMSEmailTmp->issue_opening_email_wform,
                'issue_opening_email_complaint'     => $sMSEmailTmp->issue_opening_email_complaint,
                'issue_closing_sms_wform'           => $sMSEmailTmp->issue_closing_sms_wform,
                'issue_closing_sms_complaint'       => $sMSEmailTmp->issue_closing_sms_complaint,
                'issue_closing_email_wform'         => $sMSEmailTmp->issue_closing_email_wform,
                'issue_closing_email_complaint'     => $sMSEmailTmp->issue_closing_email_complaint,
                'otp_sms'                           => $sMSEmailTmp->otp_sms,
                'otp_email'                         => $sMSEmailTmp->otp_email,
                'send_back_sms'                     => $sMSEmailTmp->send_back_sms,
                'send_back_email'                   => $sMSEmailTmp->send_back_email,
                'send_back_auto_sms'                => $sMSEmailTmp->send_back_auto_sms,
                'send_back_auto_email'              => $sMSEmailTmp->send_back_auto_email,
                'send_back_closed_sms'              => $sMSEmailTmp->send_back_closed_sms,
                'send_back_closed_email'            => $sMSEmailTmp->send_back_closed_email,
                'unreachable_cust_sms'              => $sMSEmailTmp->unreachable_cust_sms,
                'unreachable_cust_email'            => $sMSEmailTmp->unreachable_cust_email,
                'non_cust_sms'                      => $sMSEmailTmp->non_cust_sms,
                'non_cust_email'                    => $sMSEmailTmp->non_cust_email,
                'escalation_email'                  => $sMSEmailTmp->escalation_email,
                'created_by'                        => $sMSEmailTmp->created_by,
                'updated_by'                        => $sMSEmailTmp->updated_by,
                'ip'                                => $sMSEmailTmp->ip,
                'created_at'                        => now(),
                'updated_at'                        => now(),
            ];

            if($sMSEmailTmp->master_id != null && $sMSEmailTmp->action != "Add"){
                DB::table('sms_email_templates')->where('id', $sMSEmailTmp->master_id)->update($sMSEmailData);
            }else{
                DB::table('sms_email_templates')->insert($sMSEmailData);
            }

            DB::table('sms_email_template_tmps')->where('id', $sMSEmailTmp->id)->delete();
            DB::commit();

            // if($sMSEmailTmp-> == 0){
            //     flash('Group info has been inActive.', 'danger');
            // }elseif($sMSEmailTmp->status == 1){
            //     flash('Group info has been activated.', 'success');
            // }else{
            //     flash('Group info has been approved.', 'success');
            // }
            flash('SMS Mail info has been approved.', 'success');
            return redirect()->back();
        } catch (\Exception $e) {
            DB::rollBack();
            flash('An error occurred during the approval process: ' . $e->getMessage(), 'danger');
            return redirect()->back();
        }
    }

}
